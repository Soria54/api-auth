# Copier en deploiement/.env (jamais commité) puis renseigner.
# Lu par Docker Compose (variables ${…}) et transmis à l'API (env_file).

# Mot de passe de la base (long et aléatoire) :
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DB_PASSWORD=
DB_NAME=api_auth
DB_USER=api_auth

# Port de l'API sur la machine (réseau local)
PORT_API=3000
LOG_LEVEL=info
# Origines autorisées (front de musculation), séparées par des virgules
CORS_ORIGINS=http://192.168.1.50:8080
# 0 sans proxy inverse ; 1 derrière Traefik
TRUST_PROXY_HOPS=0

# Émetteur des jetons : l'URL publique une fois le domaine acheté (ex. https://auth.mondomaine.fr)
JWT_EMETTEUR=
JWT_DUREE=15m
INSCRIPTION_OUVERTE=true

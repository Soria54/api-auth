# Copier en .env.development (jamais commité) puis renseigner.
# Chargé selon NODE_ENV : .env.<NODE_ENV>, puis .env.

# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
# Origines autorisées par CORS, séparées par des virgules (vide = aucune hors développement)
CORS_ORIGINS=http://localhost:5173
# Nombre de proxys inverses devant l'API (req.ip, quotas par IP)
TRUST_PROXY_HOPS=1

# Base de données (postgres)
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=api_auth
DB_USER=
DB_PASSWORD=
# SQLite uniquement : chemin du fichier
DB_STORAGE=./api-auth.sqlite
# SQL Server uniquement
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true
# Compte des migrations (droits DDL) ; à défaut DB_USER / DB_PASSWORD
MIGRATION_USER=
MIGRATION_PASSWORD=
# Authentification JWT (EdDSA, clé Ed25519)
# Clé privée de signature, générée par : npm run cle:generer
# En production : un secret Docker monté en lecture seule (ex. /run/secrets/jwt-ed25519.pem)
JWT_CLE_PRIVEE_FICHIER=./secrets/jwt-ed25519.pem
# Émetteur (claim iss) : l'URL publique de l'API une fois le domaine acheté (défaut : api-auth)
JWT_EMETTEUR=
# Durée du jeton d'accès (non révocable : rester court)
JWT_DUREE=15m
# Inscription publique ouverte (true) ou comptes créés par un administrateur (false)
INSCRIPTION_OUVERTE=true
# @@env
